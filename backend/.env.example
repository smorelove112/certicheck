# Example environment variables for the backend
# Copy this file to .env and fill the real values (DO NOT commit secrets)

# Server
PORT=3000
NODE_ENV=development

# Database (e.g. postgres connection string)
DATABASE_URL=postgres://user:password@localhost:5432/certicheck

# JWT secret for auth
JWT_SECRET=your_jwt_secret_here

# IPFS / Pinata
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret

# Gmail SMTP. Use a Google App Password (2-Step Verification required).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
# Set SMTP_PASS only in the deployment environment (e.g. Render); never commit it.
EMAIL_FROM=CertiCheck <your-gmail@gmail.com>

# Port 587 uses STARTTLS: set SMTP_PORT=587 and SMTP_SECURE=false.
# EMAIL_USER and EMAIL_PASSWORD are also accepted as credential aliases.

# Other third-party keys
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=
PORT=5000
NODE_ENV=development
# Comma-separated exact browser origins; add the deployed Vercel origin here.
CORS_ORIGINS=https://certicheck-psi.vercel.app

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=certicheck

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Admin
# Seeded admin accounts use the shared default password: password

# Optional: separate admin JWT secret for extra isolation
ADMIN_JWT_SECRET=

# IPFS / Pinata
PINATA_JWT=

# Solana
SOLANA_ENABLE=true
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Issuance and revocation are signed by the approved issuer's connected Phantom wallet.
CERTIFICATE_PROGRAM_ID=4aCWiNjpLPtMa1gQd3Tu5jfSpKEFDR3PbANP5br8Fmob
CERTIFICATE_STORE_FILE=
DEMO_MODE=false
